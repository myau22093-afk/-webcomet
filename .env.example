# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Primary AI provider (Promptra)
PROMPTRA_API_KEY=
PROMPTRA_BASE_URL=https://api.promptra.ru/v1

# ProxyAPI (OpenAI-совместимый роутер — Claude/GPT/Gemini)
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1

# Optional direct vendor keys (unused by multi-provider layer)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ЮKassa (покупка токенов и публикации).
# 1) В кабинете ЮKassa: Интеграция → HTTP-уведомления → URL:
#    https://webcomet.ru/api/webhooks/yookassa/tokens
#    Событие: payment.succeeded
# 2) Скопируй shopId и секретный ключ сюда и на VPS в /opt/webcomet/.env
# 3) Убери YOOKASSA_STUB или не задавай его (заглушка только без ключей)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Для webhook (можно тот же секрет или отдельный):
YOOKASSA_WEBHOOK_SECRET=
# YOOKASSA_STUB=1

# Публичный URL сайта (на VPS обязательно https://webcomet.ru)
NEXT_PUBLIC_APP_URL=https://webcomet.ru
NEXT_PUBLIC_PUBLISH_BASE_DOMAIN=webcomet.ru
# Почта регистрации — в Supabase Dashboard (не в этом .env):
# Auth → SMTP: Resend Custom SMTP (noreply@webcomet.ru) уже настраивается там
# Auth → Providers → Email → Confirm email = ON
# Auth → URL Configuration → Redirect URLs: https://webcomet.ru/auth/callback*

# Партнёрка Рег.ру (можно не трогать — в коде уже твой rlink)
NEXT_PUBLIC_AFFILIATE_REGRU=https://www.reg.ru/?rlink=reflink-32113679
NEXT_PUBLIC_AFFILIATE_REGRU_DOMAIN=https://www.reg.ru/domain/new/?rlink=reflink-32113679
NEXT_PUBLIC_AFFILIATE_REGRU_HOSTING=https://www.reg.ru/hosting/?rlink=reflink-32113679

# Лимит параллельных AI-запросов на один инстанс Next (очередь, см. SCALE.md)
AI_MAX_CONCURRENT=16
# 0 = бесконечная очередь (ждать слот, не выкидывать 503). Число в мс — таймаут ожидания.
AI_QUEUE_WAIT_MS=0

# CRM-панель (/crm) — логин и пароль администратора
CRM_USERNAME=crmVASYA1337
CRM_PASSWORD=taTIchoVASYA
# Секрет подписи сессии CRM (опционально; по умолчанию service role key)
# CRM_SECRET=
