# Behind Cloudflare: HTTPS terminates at CF, origin is HTTP :80
:80 {
	encode gzip zstd
	reverse_proxy webcomet1:8080 webcomet2:8080 webcomet3:8080 {
		lb_policy round_robin
		health_uri /
		health_interval 10s
		fail_duration 30s
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
